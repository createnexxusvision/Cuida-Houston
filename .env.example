# Copy to .env for local development. Never commit .env. Never paste keys into chat.

# --- Database: pick ONE ---
# Local Postgres + PostGIS (development)
DATABASE_URL=postgres://postgres:devpass@localhost:5432/cuida
WEB_DB_PASSWORD=choose-a-12plus-char-password   # sets the cuida_web login locally
# Aurora Serverless v2 via RDS Data API (values from the infra stack outputs)
# DB_CLUSTER_ARN=arn:aws:rds:us-east-1:123456789012:cluster:cuida-hou
# DB_SECRET_ARN=<master secret ARN for the pipeline / migrations>
# WEB_SECRET_ARN=<cuida_web secret ARN>
# DB_NAME=cuida

# --- Pipeline API keys (in AWS these live in the cuida-hou/app-keys secret) ---
CENSUS_API_KEY=          # REQUIRED, free: https://api.census.gov/data/key_signup.html
SOCRATA_APP_TOKEN=       # data.texas.gov app token
COUNTY=HARRIS
ACS_YEAR=2024
