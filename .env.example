# Copy to .env for local development. Never commit .env.
# Web (public-safe)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Pipeline only (server-side secrets; in AWS these live in Secrets Manager)
SUPABASE_SERVICE_ROLE_KEY=
CENSUS_API_KEY=          # free: https://api.census.gov/data/key_signup.html
SOCRATA_APP_TOKEN=       # free: https://data.texas.gov (profile -> developer settings)
COUNTY=HARRIS
ACS_YEAR=2023
